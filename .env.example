# Leave blank for isolated local D1; an authorized deploy requires the verified target ID.
CLOUDFLARE_D1_DATABASE_ID=

# Local/public alpha only. Production defaults to `protected` when omitted.
APP_MODE=demo
DEMO_USER_EMAIL=person005@example.test

# Required when APP_MODE=protected.
# "*" accepts any Google-authenticated email; set a domain to restrict sign-in.
ALLOWED_EMAIL_DOMAIN=*
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# Direct Google OAuth for hosts that cannot be protected by Cloudflare Access.
AUTH_PROVIDER=google
GOOGLE_CLIENT_ID=

# Stable ID declared by apps/chrome-extension/manifest.json.
CHROME_EXTENSION_ID=
PUBLIC_APP_URL=http://localhost:8787

# Local Google OAuth only: put these in ignored `.dev.vars`, not this file.
# GOOGLE_CLIENT_SECRET=
# AUTH_SECRET=

# Announcement delivery. Keep real values in `.dev.vars` / hosted secrets.
# Email uses RESEND_API_KEY + INVITATION_FROM_EMAIL when available. The legacy
# email webhook below remains a fallback and must return {"ok":true} only
# after accepting the recipients.
GOOGLE_CHAT_WEBHOOK_URL=
ANNOUNCEMENT_EMAIL_WEBHOOK_URL=
ANNOUNCEMENT_WEBHOOK_SECRET=
# Optional compatibility alias used by the Google Apps Script template.
# INCORA_WEBHOOK_SECRET=
ANNOUNCEMENT_CRON_SECRET=
# Employee invitations and announcement emails use the same Resend sender.
# Keep RESEND_API_KEY in `.dev.vars` locally or a Cloudflare Worker secret.
# Employee invitations remain separately gated by EMPLOYEE_INVITATIONS_ENABLED.
EMPLOYEE_INVITATIONS_ENABLED=false
INVITATION_FROM_EMAIL=
# RESEND_API_KEY=
# Optional scanner hardening. Keep false/unset until the external scanner
# callback is configured and existing R2 objects have been scanned.
FILES_REQUIRE_SCAN=false
FILE_SCAN_WEBHOOK_SECRET=
